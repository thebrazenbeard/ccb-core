{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "WORKSTATION_RELAY_TARGETS_V1",
  "title": "BT2 Workstation Relay Local Targets V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "targets"],
  "properties": {
    "version": { "const": 1 },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recipient",
          "conversation_url",
          "visible_identity"
        ],
        "properties": {
          "recipient": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "conversation_url": {
            "type": "string",
            "pattern": "^https://(chatgpt\\.com|chat\\.openai\\.com)/"
          },
          "visible_identity": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
